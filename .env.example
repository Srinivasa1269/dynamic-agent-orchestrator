# Copy this file to ".env" and change values if you need to.
# No API key is needed: the model runs on your computer with Ollama.
# Every line is optional. A missing or blank value uses the default shown.

# Which Ollama model to use. It must support tool calling. See yours with: ollama list
OLLAMA_MODEL=llama3.1:latest
# Where Ollama is listening (this is Ollama's normal address).
OLLAMA_BASE_URL=http://localhost:11434
# How many tokens the model can read at once. Bigger uses more RAM.
OLLAMA_NUM_CTX=8192

# How long to wait (in seconds) before giving up. A laptop CPU is slow.
PLANNER_TIMEOUT_SECONDS=300
WORKER_TIMEOUT_SECONDS=600
